{
  "ConnectionStrings": {
    "DefaultConnection": "DataSource=Data/app.db;Cache=Shared"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "JwtConfig": {
    "LifeTimeMinutes": 60,
    "ValidateIssuerSigningKey": true,
    "IssuerSigningKey": "SuperSecureReferenceKeyThatShouldBeChanged",
    "ValidateIssuer": true,
    "ValidIssuer": "ApiReference",
    "ValidateAudience": true,
    "ValidAudience": "ApiReferenceAudience",
    "RequireExpirationTime": true,
    "ValidateLifetime": true
  },
  "AllowedHosts": "*",
  "ApplicationSecrets": {
    "SecretStorage": "UserSecrets", // Options: "UserSecrets", "AzureKeyVault"
    "AzureSettings": ""
  }
}