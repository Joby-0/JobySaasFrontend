@using JobySaasFrontend.Components.Setup.Steps

@if (isOpen)
{
    <div class="modal fade show setup-modal" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="setup-modal-title">
        <div class="modal-dialog modal-fullscreen m-0" role="document">
            <div class="modal-content">
                <div class="modal-header border-bottom px-4 py-3">
                    <div>
                        <h2 id="setup-modal-title" class="modal-title fs-4 mb-1">Get started</h2>
                        <span class="text-body-secondary small">Step @currentStep of @TotalSteps</span>
                    </div>

                    <button type="button" class="btn-close" aria-label="Close" @onclick="CloseAsync"></button>
                </div>

                <div class="setup-progress px-4 pt-3" aria-label="Setup progress">
                    <div class="progress" role="progressbar" aria-valuenow="@currentStep" aria-valuemin="1" aria-valuemax="@TotalSteps">
                        <div class="progress-bar" style="width: @ProgressPercentage%"></div>
                    </div>

                    <div class="setup-progress-steps" aria-hidden="true">
                        @foreach (var step in Steps)
                        {
                            <span class="setup-progress-step @(step.Number < currentStep ? "completed" : step.Number == currentStep ? "current" : "upcoming")">
                                <span class="setup-progress-circle">
                                    @if (step.Number < currentStep)
                                    {
                                        <span>&check;</span>
                                    }
                                    else
                                    {
                                        @step.Number
                                    }
                                </span>
                                <span class="setup-progress-label">@step.Title</span>
                            </span>
                        }
                    </div>
                </div>

                <div class="modal-body setup-modal-body">
                    <div @key="currentStep" class="setup-step-page @transitionClass">
                        @switch (currentStep)
                        {
                            case 1:
                                <OrganizationStep />
                                break;
                            case 2:
                                <PlanStep />
                                break;
                            case 3:
                                <PaymentStep />
                                break;
                            case 4:
                                <CompleteStep />
                                break;
                        }
                    </div>
                </div>

                <div class="modal-footer justify-content-between px-4 py-3">
                    <button type="button" class="btn btn-outline-secondary" @onclick="BackAsync" disabled="@(currentStep == 1)">
                        Back
                    </button>

                    <button type="button" class="btn btn-primary" @onclick="NextAsync">
                        @(currentStep == TotalSteps ? "Finish" : "Next")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private const int FirstStep = 1;

    private static readonly IReadOnlyList<SetupStepInfo> Steps =
    [
        new(1, "Organization"),
        new(2, "Choose plan"),
        new(3, "Payment"),
        new(4, "Complete")
    ];

    private bool isOpen;
    private int currentStep = FirstStep;
    private string transitionClass = "setup-slide-forward";

    public int TotalSteps => Steps.Count;

    public int CurrentStep => currentStep;

    public int ProgressPercentage => currentStep * 100 / TotalSteps;

    public Task OpenAsync(int step)
    {
        currentStep = Math.Clamp(step, FirstStep, TotalSteps);
        transitionClass = "setup-slide-forward";
        isOpen = true;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private Task NextAsync()
    {
        if (currentStep == TotalSteps)
        {
            return CloseAsync();
        }

        transitionClass = "setup-slide-forward";
        currentStep++;
        return Task.CompletedTask;
    }

    private Task BackAsync()
    {
        if (currentStep == FirstStep)
        {
            return Task.CompletedTask;
        }

        transitionClass = "setup-slide-back";
        currentStep--;
        return Task.CompletedTask;
    }

    private Task CloseAsync()
    {
        isOpen = false;
        return Task.CompletedTask;
    }

    private sealed record SetupStepInfo(int Number, string Title);
}
