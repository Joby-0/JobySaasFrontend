<section aria-labelledby="plan-step-title">
    <h3 id="plan-step-title" class="h4">Choose a plan</h3>
    <p class="text-body-secondary">Select the plan that best fits your organization.</p>

    <div class="form-check border rounded p-3 mb-2">
        <input id="starter-plan" class="form-check-input ms-0 me-2" type="radio" name="plan" checked />
        <label for="starter-plan" class="form-check-label">Starter</label>
    </div>

    <div class="form-check border rounded p-3">
        <input id="growth-plan" class="form-check-input ms-0 me-2" type="radio" name="plan" />
        <label for="growth-plan" class="form-check-label">Growth</label>
    </div>
</section>
