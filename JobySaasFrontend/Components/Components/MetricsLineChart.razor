@using System.Text.Json
@using JobySaasFrontend.Models.DTO
@inject IJSRuntime JS

<div class="h-100 border p-3 rounded-4">
    <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2 bg-white">
        <h6 class="mb-0"></h6>

        <!-- Metric multi-select dropdown -->
        <div class="dropdown">
            <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown"
                    aria-expanded="false">
                Metrics (@SelectedMetrics.Count)
            </button>
            <ul class="dropdown-menu p-2" style="min-width: 220px;">
                @foreach (var metric in AllMetrics)
                {
                    <li>
                        <div class="form-check d-flex align-items-center gap-2">
                            <input class="form-check-input" type="checkbox" id="chk-@metric"
                                   checked="@SelectedMetrics.Contains(metric)"
                                   @onchange="e => ToggleMetric(metric, (bool)e.Value!)" />
                            <label class="form-check-label d-flex align-items-center gap-2" for="chk-@metric">
                                <svg width="16" height="8" aria-hidden="true">
                                    <line x1="0" y1="4" x2="16" y2="4"
                                          stroke="@MetricColors[metric]" stroke-width="2"
                                          stroke-dasharray="@DashArrayCss(metric)" />
                                </svg>
                                @MetricLabels[metric]
                            </label>
                        </div>
                    </li>
                }
            </ul>
        </div>
    </div>
    <div class="card-body position-relative">
        @if (IsLoading)
        {
            <div class="position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center bg-white bg-opacity-75"
                 style="z-index:2;">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div>
        }

        @* Custom legend so it matches the dash pattern shown in the metric picker *@
        <div class="d-flex flex-wrap gap-3 mb-2" style="font-size: 12px; color: var(--bs-secondary-color, #6c757d);">
            @foreach (var metric in AllMetrics.Where(m => SelectedMetrics.Contains(m)))
            {
                <span class="d-flex align-items-center gap-1">
                    <svg width="14" height="8" aria-hidden="true">
                        <line x1="0" y1="4" x2="14" y2="4"
                              stroke="@MetricColors[metric]" stroke-width="2"
                              stroke-dasharray="@DashArrayCss(metric)" />
                    </svg>
                    @MetricLabels[metric]
                </span>
            }
        </div>

        <canvas id="@ChartId" role="img" aria-label="@ChartAriaLabel" style="max-height: 320px;"></canvas>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public List<DailyMetricDto> Data { get; set; } = new();

    [Parameter]
    public string Title { get; set; } = "Channel Metrics";

    [Parameter]
    public bool IsLoading { get; set; }

    private static readonly string[] AllMetrics = { "Views", "Likes", "Comments", "Shares" };

    private static readonly Dictionary<string, string> MetricLabels = new()
    {
        ["Views"] = "Views",
        ["Likes"] = "Likes",
        ["Comments"] = "Comments",
        ["Shares"] = "Shares"
    };

    private static readonly Dictionary<string, string> MetricColors = new()
    {
        ["Views"] = "#2a78d6",
        ["Likes"] = "#eb6834",
        ["Comments"] = "#1baf7a",
        ["Shares"] = "#eda100"
    };

    // Dash pattern per metric - mirrors the borderDash arrays sent to Chart.js,
    // so the SVG previews in the legend/picker match the actual chart lines.
    private static readonly Dictionary<string, int[]> MetricDashes = new()
    {
        ["Views"] = Array.Empty<int>(),   // solid
        ["Likes"] = new[] { 6, 3 },
        ["Comments"] = new[] { 1, 3 },
        ["Shares"] = new[] { 2, 2, 6, 2 }
    };

    private HashSet<string> SelectedMetrics = new();

    private string ChartId { get; } = $"chart-{Guid.NewGuid():N}";
    private bool _hasRendered;
    private List<DailyMetricDto>? _lastRenderedData;

    private string ChartAriaLabel =>
        $"Line chart of {string.Join(", ", SelectedMetrics)} over the selected date range";

    protected override void OnInitialized()
    {
        SelectedMetrics = new HashSet<string>(AllMetrics);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _hasRendered = true;
            await RenderChartAsync();
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_hasRendered && !ReferenceEquals(Data, _lastRenderedData))
        {
            await RenderChartAsync();
        }
    }

    private async Task ToggleMetric(string metric, bool isChecked)
    {
        if (isChecked) SelectedMetrics.Add(metric);
        else SelectedMetrics.Remove(metric);

        await RenderChartAsync();
    }

    private string DashArrayCss(string metric) =>
        MetricDashes[metric].Length == 0 ? "none" : string.Join(",", MetricDashes[metric]);

    private async Task RenderChartAsync()
    {
        if (!_hasRendered) return;

        _lastRenderedData = Data;

        var ordered = Data.OrderBy(d => d.Date).ToList();
        var labels = ordered.Select(d => d.Date.ToString("MMM dd")).ToArray();

        var datasets = AllMetrics
            .Where(m => SelectedMetrics.Contains(m))
            .Select(m => new
            {
                label = MetricLabels[m],
                color = MetricColors[m],
                dash = MetricDashes[m],
                data = ordered.Select(d => GetMetricValue(d, m)).ToArray()
            })
            .ToArray();

        await JS.InvokeVoidAsync("metricsChart.render", ChartId, labels, datasets);
    }

    private long GetMetricValue(DailyMetricDto d, string metric) => metric switch
    {
        "Views" => d.Views,
        "Likes" => d.Likes,
        "Comments" => d.Comments,
        "Shares" => d.Shares,
        _ => 0
    };
}