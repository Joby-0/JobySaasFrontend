<div class="d-flex justify-content-center">
    <div class="w-100" style="max-width: 600px;">

        <div class="text-center mb-4">
            <h4 class="fw-bold" style="color: var(--color-primary);">
                Review
            </h4>
            <p class="text-muted mb-0">
                Check everything looks right before continuing to payment.
            </p>
        </div>

        <div class="d-flex flex-column gap-3">

            <!-- Organization -->
            <div class="border rounded-3 p-3 bg-white">
                <div class="text-muted small mb-1">
                    Organization
                </div>

                <div class="fw-semibold">
                    @Draft.OrgName
                </div>
            </div>

            <!-- Plan -->
            <div class="border rounded-3 p-3 bg-white">
                <div class="text-muted small mb-1">
                    Plan
                </div>

                <div class="fw-semibold">
                    @Draft.SelectedPlan?.Name
                </div>

                <div class="text-muted small mt-1">
                    @if (Draft.SelectedPlan?.BillingIntervalInMonths == 12)
                    {
                        <span>€@Draft.SelectedPlan?.Price / year</span>
                    }
                    else
                    {
                        <span>€@Draft.SelectedPlan?.Price / month</span>
                    }
                </div>
            </div>

            <!-- Payment -->
            <div class="border rounded-3 p-3 bg-white">
                <div class="text-muted small mb-1">
                    Payment
                </div>

                <div class="fw-semibold">
                    @if (Draft.SelectedPlan?.ContactSales == true)
                    {
                        <span>Contact sales</span>
                    }
                    else if (Draft.SelectedPlan?.IsFree == true)
                    {
                        <span>Free plan</span>
                    } 
                    else
                    {
                        <span>Stripe Checkout</span>
                    }
                </div>
            </div>

        </div>

        <!-- Continue -->
        <div class="d-grid mt-4">
            <button class="btn btn-secondary btn-lg" disabled="@IsSubmitting"
                    @onclick="() => OnCompleted.InvokeAsync()">

                @if (IsSubmitting)
                {
                    <span class="spinner-border spinner-border-sm me-2"></span>
                }

                Continue to payment
            </button>
        </div>

    </div>
</div>

@code {
    [Parameter] public OnboardingDraft Draft { get; set; } = default!;
    [Parameter] public EventCallback OnCompleted { get; set; }
    [Parameter] public bool IsSubmitting { get; set; }
}