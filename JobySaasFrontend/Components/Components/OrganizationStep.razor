@using JobySaasFrontend.Models.DTO
@using JobySaasFrontend.Services
@inject IOrganizationApiClient OrganizationApi


<div class="d-flex justify-content-center">
    <div class="w-100" style="max-width: 480px;">

        <div class="text-center mb-4">
            <h4 class="fw-bold" style="color: var(--color-primary);">Create your organization</h4>
            <p class="text-muted">This is the workspace your team and content will live in.</p>
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold">Organization name</label>
            <input class="form-control form-control-lg" @bind="@OrgName"
                   @oninput="(e) => OrgNameChanged.InvokeAsync((string)e.Value!)" placeholder="e.g. Acme Studios" />
        </div>

        <div class="d-grid mt-4">
            <button class="btn btn-secondary btn-lg" disabled="@string.IsNullOrWhiteSpace(OrgName)"
                    @onclick="() => OnCompleted.InvokeAsync()">
                Continue
            </button>
        </div>

    </div>
</div>

@code {
    [Parameter] public string OrgName { get; set; } = "";
    [Parameter] public EventCallback<string> OrgNameChanged { get; set; }
    [Parameter] public EventCallback OnCompleted { get; set; }
}