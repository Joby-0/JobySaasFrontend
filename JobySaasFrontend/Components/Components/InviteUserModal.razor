@using BlazorBootstrap
@using JobySaasFrontend.Data
@using JobySaasFrontend.Models
@using JobySaasFrontend.Models.DTO
@using JobySaasFrontend.Services
@using Microsoft.AspNetCore.Identity
@inject IInvitationApiClient invitationApiClient
@inject IEmailService sender
@implements IDisposable
@inject IJSRuntime JS
<Modal @ref="inviteModal">

    <HeaderTemplate>
        <h5 class="mb-0">Invite members</h5>
    </HeaderTemplate>

    <BodyTemplate>

        @if (!inviteTypeSelected)
        {
            <div class="mb-3">
                <p class="text-muted mb-3">
                    Choose how you want to invite someone.
                </p>

                <button class="invite-option w-100 text-start mb-3" @onclick="() => SelectInviteType(true)">

                    <div class="d-flex align-items-center gap-3">
                        <div class="invite-icon">
                            <Icon Name="IconName.Lock" />
                        </div>

                        <div>
                            <div class="fw-semibold">
                                Private invite
                            </div>

                            <div class="small text-muted">
                                Invite a specific person by email.
                            </div>
                        </div>
                    </div>

                </button>

                <button class="invite-option w-100 text-start" @onclick="() => SelectInviteType(false)">

                    <div class="d-flex align-items-center gap-3">
                        <div class="invite-icon">
                            <Icon Name="IconName.Link45Deg" />
                        </div>

                        <div>
                            <div class="fw-semibold">
                                Public invite
                            </div>

                            <div class="small text-muted">
                                Create a link that others can use.
                            </div>
                        </div>
                    </div>

                </button>
            </div>
        }
        else if (isPrivateInvite)
        {
            <div>
                <button class="btn btn-sm p-0 mb-3" @onclick="ResetInviteType">
                    Back
                </button>
                <span>This invite will be avaible for 24 hours</span>

                <div class="mb-3">
                    <label class="form-label fw-semibold">
                        Email
                    </label>

                    <InputText class="form-control" @bind-Value="email" placeholder="name@example.com" />
                </div>
            </div>
        }
        else
        {
            <div>

                <button class="btn btn-sm p-0 mb-3" @onclick="ResetInviteType">
                    Back
                </button>

                
                @if (invitation is not null)
                {
                    <div class="text-center">

                        <div class="invite-code-box position-relative mb-3">

                            <button class="copy-code-btn" title="Copy invite code" @onclick="CopyInviteCode">

                                <i class="bi bi-copy"></i>

                            </button>

                            <span class="invite-code">
                                @invitation.Code
                            </span>

                        </div>

                        <div class="text-muted">
                            @if (remainingTime > TimeSpan.Zero)
                            {
                                <span>
                                    Expires in
                                    <strong>@FormatRemainingTime()</strong>
                                </span>
                            }
                            else
                            {
                                <span class="text-danger">
                                    This invite has expired
                                </span>
                            }
                        </div>

                    </div>
                }
                else
                {
                    <div class="mb-3">

                        <label class="form-label fw-semibold">
                            Expires after
                        </label>

                        <select class="form-select" @bind="expirationInMinutes">

                            <option value="5">5 minutes</option>
                            <option value="15">15 minutes</option>
                            <option value="60">1 hour</option>
                            <option value="1440">1 day</option>

                        </select>

                    </div>
                }

            </div>
        }

    </BodyTemplate>

    <FooterTemplate>

        @if (inviteTypeSelected)
        {
            <button class="btn btn-secondary" @onclick="ResetInviteType">
                Back
            </button>

            @if (isPrivateInvite)
            {
                <button class="btn btn-primary" @onclick="SendPrivateInvite">
                    Send invite
                </button>
            }
            else
            {
                <button class="btn btn-primary" @onclick="CreatePublicInvite">
                    Create invite link
                </button>
            }
        }
        else
        {
            <button class="btn btn-secondary" @onclick="CloseInviteModal">
                Cancel
            </button>
        }

    </FooterTemplate>

</Modal>

@code
{
    [Parameter]
    public Guid organizationId { get; set; }

    private bool inviteTypeSelected = false;
    private bool isPrivateInvite = false;

    private Modal inviteModal = new Modal();

    private string email = "";
    private int expirationInMinutes = 1440;
    private string publicInviteCode = "";

    private TimeSpan remainingTime;
    private PeriodicTimer? countdownTimer;
    private CancellationTokenSource? countdownCts;

    private InvitationDto? invitation;

    private void SelectInviteType(bool privateInvite)
    {
        isPrivateInvite = privateInvite;
        inviteTypeSelected = true;
    }

    private void ResetInviteType()
    {
        inviteTypeSelected = false;
        isPrivateInvite = false;
    }

    private async Task SendPrivateInvite()
    {
        await CreateInvite();
        if (invitation == null)
        {

        }
        else
        {
            await sender.SendInvitationAsync(invitation.Code, email);
            ResetInviteType();
        }
    }
    private string FormatRemainingTime()
    {
        if (remainingTime.TotalDays >= 1)
        {
            return $"{(int)remainingTime.TotalDays}d " +
                   $"{remainingTime.Hours:00}:" +
                   $"{remainingTime.Minutes:00}:" +
                   $"{remainingTime.Seconds:00}";
        }

        return $"{remainingTime.Hours:00}:" +
               $"{remainingTime.Minutes:00}:" +
               $"{remainingTime.Seconds:00}";
    }

    private async Task CreatePublicInvite()
    {
        await CreateInvite();
        if (invitation == null)
        {

        }
        else
        {
            publicInviteCode = invitation.Code;

            await StartCountdown();

            StateHasChanged();
        }

    }
    private async Task CopyInviteCode()
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", publicInviteCode);
    }
    private async Task ShareInvite()
    {
        await JS.InvokeVoidAsync(
            "navigator.share",
            new
            {
                title = "JobySaaS invitation",
                text = $"Use this invite code to join: {publicInviteCode}"
            });
    }
    private async Task CreateInvite()
    {
        var result = await invitationApiClient.CreateInviteCodeAsync(
            organizationId,
            expirationInMinutes,
            email);

        if (result.Success)
        {
            invitation = result.Data;

            await StartCountdown();
        }
    }

    private async Task CloseInviteModal()
    {
        inviteTypeSelected = false;
        isPrivateInvite = false;
        publicInviteCode = "";
        Dispose();
        // Close modal
    }
    public async Task ShowAsync()
    {
        await inviteModal.ShowAsync();
    }

    private async Task StartCountdown()
    {
        countdownCts?.Cancel();
        countdownCts?.Dispose();

        countdownCts = new CancellationTokenSource();

        UpdateRemainingTime();

        countdownTimer = new PeriodicTimer(TimeSpan.FromSeconds(1));

        try
        {
            while (await countdownTimer.WaitForNextTickAsync(countdownCts.Token))
            {
                UpdateRemainingTime();

                await InvokeAsync(StateHasChanged);

                if (remainingTime <= TimeSpan.Zero)
                    break;
            }
        }
        catch (OperationCanceledException)
        {
        }
    }
    private void UpdateRemainingTime()
    {
        if (invitation is null)
            return;

        remainingTime = invitation.ExpiresAt - DateTime.UtcNow;

        if (remainingTime < TimeSpan.Zero)
            remainingTime = TimeSpan.Zero;
    }
    public void Dispose()
    {
        countdownCts?.Cancel();
        countdownCts?.Dispose();
        countdownTimer?.Dispose();
    }
}