@using BlazorBootstrap
<Modal @ref="inviteModal">

    <HeaderTemplate>
        <h5 class="mb-0">Invite members</h5>
    </HeaderTemplate>

    <BodyTemplate>

        @if (!inviteTypeSelected)
        {
            <div class="mb-3">
                <p class="text-muted mb-3">
                    Choose how you want to invite someone.
                </p>

                <button class="invite-option w-100 text-start mb-3"
                        @onclick="() => SelectInviteType(true)">

                    <div class="d-flex align-items-center gap-3">
                        <div class="invite-icon">
                            <Icon Name="IconName.Lock" />
                        </div>

                        <div>
                            <div class="fw-semibold">
                                Private invite
                            </div>

                            <div class="small text-muted">
                                Invite a specific person by email.
                            </div>
                        </div>
                    </div>

                </button>

                <button class="invite-option w-100 text-start"
                        @onclick="() => SelectInviteType(false)">

                    <div class="d-flex align-items-center gap-3">
                        <div class="invite-icon">
                            <Icon Name="IconName.Link45Deg" />
                        </div>

                        <div>
                            <div class="fw-semibold">
                                Public invite
                            </div>

                            <div class="small text-muted">
                                Create a link that others can use.
                            </div>
                        </div>
                    </div>

                </button>
            </div>
        }
        else if (isPrivateInvite)
        {
            <div>
                <button class="btn btn-sm p-0 mb-3"
                        @onclick="ResetInviteType">
                    ← Back
                </button>

                <div class="mb-3">
                    <label class="form-label fw-semibold">
                        Email
                    </label>

                    <InputText class="form-control"
                               @bind-Value="email"
                               placeholder="name@example.com" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">
                        Role
                    </label>

                    <select class="form-select"
                            @bind="role">
                        <option value="Member">Member</option>
                        <option value="Admin">Admin</option>
                    </select>
                </div>
            </div>
        }
        else
        {
            <div>
                <button class="btn btn-sm p-0 mb-3"
                        @onclick="ResetInviteType">
                    ← Back
                </button>

                <div class="mb-3">
                    <label class="form-label fw-semibold">
                        Role
                    </label>

                    <select class="form-select"
                            @bind="role">
                        <option value="Member">Member</option>
                        <option value="Admin">Admin</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">
                        Expires after
                    </label>

                    <select class="form-select"
                            @bind="expirationDays">
                        <option value="1">1 day</option>
                        <option value="7">7 days</option>
                        <option value="14">14 days</option>
                        <option value="30">30 days</option>
                    </select>
                </div>
            </div>
        }

    </BodyTemplate>

    <FooterTemplate>

        @if (inviteTypeSelected)
        {
            <button class="btn btn-secondary"
                    @onclick="ResetInviteType">
                Back
            </button>

            @if (isPrivateInvite)
            {
                <button class="btn btn-primary"
                        @onclick="SendPrivateInvite">
                    Send invite
                </button>
            }
            else
            {
                <button class="btn btn-primary"
                        @onclick="CreatePublicInvite">
                    Create invite link
                </button>
            }
        }
        else
        {
            <button class="btn btn-secondary"
                    @onclick="CloseInviteModal">
                Cancel
            </button>
        }

    </FooterTemplate>

</Modal>

@code
{
    [Parameter]
    public Guid organizationId { get; set; }

    private bool inviteTypeSelected = false;
    private bool isPrivateInvite = false;

    private Modal inviteModal = new Modal();

    private string email = "";
    private string role = "Member";
    private int expirationDays = 7;

    private void SelectInviteType(bool privateInvite)
    {
        isPrivateInvite = privateInvite;
        inviteTypeSelected = true;
    }

    private void ResetInviteType()
    {
        inviteTypeSelected = false;
        isPrivateInvite = false;
    }

    private async Task SendPrivateInvite()
    {
        // Call API
    }

    private async Task CreatePublicInvite()
    {
        // Call API
    }

    private async Task CloseInviteModal()
    {
        inviteTypeSelected = false;
        isPrivateInvite = false;

        // Close modal
    }
}