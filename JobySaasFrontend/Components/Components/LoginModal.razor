@using BlazorBootstrap

<Modal @ref="modal">
    <HeaderTemplate><h5 class="modal-title mb-1">Sign in to your account</h5></HeaderTemplate>
    <BodyTemplate>
        <EditForm Model="loginModel" method="post" action="/Account/Login?ReturnUrl=%2F" FormName="login">
            <DataAnnotationsValidator />
            <input type="hidden" name="ReturnUrl" value="/" />
            @if (errorMessage is not null)
            {
                <div class="alert alert-danger" role="alert">@errorMessage</div>
            }
            <div class="row g-3 login-form p-2">
                <div class="col-12 form-floating">
                    <InputText id="login-email" name="Input.Email" class="form-control" type="email" placeholder="Email" autocomplete="username" @bind-Value="loginModel.Email" />
                    <label for="login-email">Email</label>
                    <ValidationMessage For="@(() => loginModel.Email)" class="invalid-feedback d-block ps-1" />
                </div>
                <div class="col-12 form-floating">
                    <InputText id="login-password" name="Input.Password" class="form-control" type="password" placeholder="Password" autocomplete="current-password" @bind-Value="loginModel.Password" />
                    <label for="login-password">Password</label>
                    <ValidationMessage For="@(() => loginModel.Password)" class="invalid-feedback d-block ps-1" />
                </div>
                <div class="col-12">
                    <div class="form-check">
                        <InputCheckbox id="login-remember-me" name="Input.RememberMe" class="form-check-input" @bind-Value="loginModel.RememberMe" />
                        <label class="form-check-label" for="login-remember-me">Remember me</label>
                    </div>
                </div>
            </div>
            <div class="d-grid mt-4">
                <button type="submit" class="btn btn-primary">Sign in</button>
            </div>
        </EditForm>
        <div class="text-center mt-4">
            <span>Don't have an account?</span>
            <button type="button" class="btn btn-link text-decoration-none p-0 ms-1" @onclick="OpenRegister">Register</button>
        </div>
    </BodyTemplate>
    <FooterTemplate>
        <button type="button" class="btn btn-link text-decoration-none" @onclick="CloseModal">Close</button>
    </FooterTemplate>
</Modal>
