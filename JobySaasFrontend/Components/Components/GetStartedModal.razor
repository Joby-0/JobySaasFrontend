@using BlazorBootstrap
<Modal @ref="modal" Title="Let's get you set up" Size="ModalSize.ExtraLarge" Fullscreen="ModalFullscreen.Always"  IsVerticallyCentered="true">
    <BodyTemplate>
        <div class="progress-div position-relative py-3 mb-4">
            <div class="progress-line-bg"></div>
            <div class="progress-line-fill" style="width: @ProgressPercent%;"></div>

            <div class="d-flex justify-content-between align-items-center position-relative" style="height: 56px;">
                @for (int i = 1; i <= 4; i++)
                {
                    var stepIndex = i;
                    <span class="badge rounded-circle d-flex align-items-center justify-content-center step-circle @(stepIndex <= CurrentStep ? "step-active" : "")">
                        @stepIndex
                    </span>
                }
            </div>
        </div>

        @switch (CurrentStep)
        {
            case 1:
                <OrganizationStep OnCompleted="() => GoToStep(2)" />
                break;
            case 2:
                <PlanStep OnCompleted="() => GoToStep(3)" />
                break;
            case 3:
                <PaymentStep OnCompleted="() => GoToStep(4)" />
                break;
            case 4:
                <CompleteStep OnFinish="CloseAsync" />
                break;
        }
    </BodyTemplate>
    <FooterTemplate>
        @if (CurrentStep > 1 && CurrentStep < 4)
        {
            <button class="btn btn-outline-secondary" @onclick="GoBack">Back</button>
        }
    </FooterTemplate>
</Modal>

@code {
    private Modal modal = default!;

    public int CurrentStep { get; private set; } = 1;

    private double ProgressPercent => (CurrentStep - 1) / 3.0 * 100;

    public async Task OpenAsync(int step)
    {
        CurrentStep = step is >= 1 and <= 4 ? step : 1;
        await modal.ShowAsync();
    }

    public async Task CloseAsync()
    {
        await modal.HideAsync();
    }

    private void GoToStep(int step)
    {
        CurrentStep = step;
        StateHasChanged();
    }

    private void GoBack()
    {
        if (CurrentStep > 1) CurrentStep--;
    }
}