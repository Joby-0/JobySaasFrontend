@using BlazorBootstrap
@using JobySaasFrontend.Models.DTO
@using JobySaasFrontend.Services
<Modal @ref="modal" Title="Let's get you set up" Size="ModalSize.ExtraLarge" Fullscreen="ModalFullscreen.Always"
       IsVerticallyCentered="true">
    <BodyTemplate>

        @switch (CurrentStep)
        {
            case 1:
                <OrganizationStep OrgName="" OrgNameChanged="(v) => draft.OrgName = v" OnCompleted="() => GoToStep(2)" />
                break;
            case 2:
                <PlanStep SelectedPlan="draft.SelectedPlan" SelectedPlanChanged="(v) => draft.SelectedPlan = v" OnCompleted="() => GoToStep(3)" />
                break;
            case 3:
                <ReviewStep Draft="draft" OnCompleted="HandleFinalSubmit" IsSubmitting="isSubmitting" />
                break;
            case 4:
                <CompleteStep OnFinish="CloseAsync" />
                break;
        }
    </BodyTemplate>
    <FooterTemplate>
        @if (CurrentStep > 1 && CurrentStep < 4)
        {
            <button class="btn btn-outline-secondary" @onclick="GoBack">Back</button>
        }
    </FooterTemplate>
</Modal>

@code {
    private Modal modal = default!;
    private OnboardingDraft draft = new();
    private bool isSubmitting;

    public int CurrentStep { get; private set; } = 1;
    private double ProgressPercent => (CurrentStep - 1) / 3.0 * 100;

    public async Task OpenAsync(int step)
    {
        draft = new OnboardingDraft(); // fresh draft each time it's opened
        CurrentStep = step is >= 1 and <= 4 ? step : 1;
        await modal.ShowAsync();
    }

    public async Task CloseAsync() => await modal.HideAsync();

    private void GoToStep(int step) { CurrentStep = step; }
    private void GoBack() { if (CurrentStep > 1) CurrentStep--; }

    [Inject] private IOrganizationApiClient OrganizationApi { get; set; } = default!;
    [Inject] private ISubscriptionApiClient SubscriptionApi { get; set; } = default!;

    private async Task HandleFinalSubmit()
    {
        isSubmitting = true;
        try
        {
            var org = await OrganizationApi.CreateOrganizationAsync(new CreateOrganizationRequest(draft.OrgName));
            var checkout = await SubscriptionApi.CreateSubscriptionCheckoutAsync(org.Id, draft.SelectedPlan!.Id);

            GoToStep(4);
            // or: NavigationManager.NavigateTo(checkout.CheckoutUrl, forceLoad: true);
            // depending on whether Stripe checkout happens inline or via redirect — worth deciding next
        }
        finally
        {
            isSubmitting = false;
        }
    }
}