@using JobySaasFrontend.Services
@inject IOrganizationApiClient OrganizationApi

@inject NavigationManager NavigationManager
@if (!isLoading && !hasOrganization)
{
    <div class="">

        <h1 class="card-title fw-bold mb-1 color-primary">Let's get you set up</h1>
        @* <p class="lead mb-1">A few quick steps and you're ready to publish.</p> *@
        <div class="progress-div py-4 position-relative mb-1 w-50">

            <div class="progress-line-bg"></div>
            <div class="progress-line-fill" style="width: @ProgressPercent%;"></div>

            <div class="d-flex mx-1 justify-content-between position-relative">
                @for (int i = 1; i <= 4; i++)
                {
                    var stepIndex = i;
                    <div class="d-flex flex-column align-items-center step-circle-wrap">
                        <span
                            class="badge rounded-circle d-flex align-items-center justify-content-center step-circle @(stepIndex <= CurrentStep ? "step-active" : "")">
                            @stepIndex
                        </span>
                    </div>
                }
            </div>
        </div>
        <div class="step-div d-flex align-items-center mb-4">
            <h4 class="fw-semibold mb-0">Step @CurrentStep:</h4>
            <span class="ms-2 fs-5">@StepNames[CurrentStep - 1]</span>
        </div>

        <button @onclick='() => NavigationManager.NavigateTo("/onboarding/organization")' class="btn btn-secondary">Get
            started</button>
        </div>
    }

@code {

    private bool isLoading = true;
    private bool hasOrganization;
    private double ProgressPercent => (CurrentStep - 1) / 3.0 * 100;
    [Parameter] public int CurrentStep { get; set; } = 1;

    private readonly string[] StepNames = { "Tell us a bit more about your organization", "Plan", "Payment", "Complete" };


    protected override async Task OnInitializedAsync()
    {
        @* var orgs = await OrganizationApi.GetOrganizationAsync();
        hasOrganization = orgs.Count > 0; *@
        isLoading = false;
    }
}