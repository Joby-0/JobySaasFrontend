@* PlatformIcon.razor *@
<span class="platform-icon" style="width: @(Size)px; height: @(Size)px; display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0;">
    @switch (Platform)
    {
        case "YouTube":
            <svg viewBox="0 0 24 24" width="@Size" height="@Size">
                <path fill="#FF0000" d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8Z"/>
                <path fill="#FFFFFF" d="M9.6 15.6 15.8 12 9.6 8.4v7.2Z"/>
            </svg>
            break;

        case "Instagram":
            <svg viewBox="0 0 24 24" width="@Size" height="@Size">
                <defs>
                    <linearGradient id="ig-grad" x1="0%" y1="100%" x2="100%" y2="0%">
                        <stop offset="0%" stop-color="#FFDD55"/>
                        <stop offset="50%" stop-color="#FF543E"/>
                        <stop offset="100%" stop-color="#C837AB"/>
                    </linearGradient>
                </defs>
                <rect width="24" height="24" rx="6" fill="url(#ig-grad)"/>
                <circle cx="12" cy="12" r="4.2" fill="none" stroke="#fff" stroke-width="1.6"/>
                <circle cx="17.4" cy="6.6" r="1.1" fill="#fff"/>
            </svg>
            break;

        case "TikTok":
            <svg viewBox="0 0 24 24" width="@Size" height="@Size">
                <path fill="#000000" d="M16.6 0h-3.3v15.4a3.1 3.1 0 1 1-2.2-3v-3.3a6.4 6.4 0 1 0 5.5 6.3V8.1a7.6 7.6 0 0 0 4.4 1.4V6.2a4.3 4.3 0 0 1-4.4-4.3V0Z"/>
            </svg>
            break;
    }
</span>

@code {
    [Parameter] public string Platform { get; set; } = "";
    [Parameter] public int Size { get; set; } = 20;
}
