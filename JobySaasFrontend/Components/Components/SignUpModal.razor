@using BlazorBootstrap

<Modal @ref="modal">
    <HeaderTemplate>
        <div>
            <h5 class="modal-title mb-1">Create your account</h5>
        </div>
    </HeaderTemplate>

    <BodyTemplate>
        <EditForm Model="signupModel" OnValidSubmit="HandleSubmit" FormName="signup-form">
            <DataAnnotationsValidator />

            <div class="row g-3 signup-form p-2">
                <div class="col-md-12 form-floating">
                    <InputText id="signup-first-name" class="form-control" placeholder="First Name" autocomplete="given-name" @bind-Value="signupModel.FirstName" />

                    <label for="signup-first-name" >First Name</label>

                    <ValidationMessage For="@(() => signupModel.FirstName)" class="invalid-feedback d-block ps-1"/>
                </div>

                <div class="col-md-12 form-floating">
                    <InputText id="signup-last-name" class="form-control" placeholder="Last Name" autocomplete="family-name" @bind-Value="signupModel.LastName" />

                    <label for="signup-last-name">Last Name</label>

                    <ValidationMessage For="@(() => signupModel.LastName)" class="invalid-feedback d-block ps-1"/>
                </div>

                <div class="col-12 form-floating">
                    <InputText id="signup-email" class="form-control" type="email" placeholder="Email" autocomplete="email" @bind-Value="signupModel.Email" />

                    <label for="signup-email">Email</label>

                    <ValidationMessage For="@(() => signupModel.Email)" class="invalid-feedback d-block ps-1"/>
                </div>

                <div class="col-md-12 form-floating">
                    <InputText id="signup-password" class="form-control" type="password" placeholder="Password" autocomplete="new-password" @bind-Value="signupModel.Password" />

                    <label for="signup-password">Password</label>

                    <ValidationMessage For="@(() => signupModel.Password)" class="invalid-feedback d-block ps-1"/>
                </div>

                <div class="col-md-12 form-floating">
                    <InputText id="signup-confirm-password" class="form-control" type="password" placeholder="Confirm Password" autocomplete="new-password" @bind-Value="signupModel.ConfirmPassword" />

                    <label for="signup-confirm-password">Confirm Password</label>

                    <ValidationMessage For="@(() => signupModel.ConfirmPassword)" class="invalid-feedback d-block ps-1" />
                </div>
            </div>

            <div class="d-grid mt-4">
                <button type="submit" class="btn btn-primary signup-modal-submit">Sign Up</button>
            </div>
        </EditForm>
    </BodyTemplate>

    <FooterTemplate>
        <button type="button" class="btn btn-link text-decoration-none" @onclick="CloseModal">Close</button>
    </FooterTemplate>
</Modal>
