@using JobySaasFrontend.Models
@using JobySaasFrontend.Services
@implements IDisposable
@inject AlertService AlertService

<div class="alert-container">

    @foreach (var alert in AlertService.Alerts)
    {
        <div class="custom-alert @GetAlertClass(alert.Type)">

            <div class="alert-icon">
                <i class="@GetIcon(alert.Type)"></i>
            </div>

            <div class="alert-message">
                @alert.Message
            </div>

            <button class="alert-close"
                    @onclick="() => Close(alert.Id)">
                <i class="bi bi-x"></i>
            </button>

        </div>
    }

</div>

@code {

    protected override void OnInitialized()
    {
        AlertService.OnChange += OnAlertChanged;
    }

    private async void OnAlertChanged()
    {
        await InvokeAsync(StateHasChanged);

        foreach (var alert in AlertService.Alerts.ToList())
        {
            if (alert.AutoHide)
            {
                _ = AutoRemove(alert);
            }
        }
    }

    private async Task AutoRemove(AlertMessage alert)
    {
        await Task.Delay(alert.Duration);

        if (AlertService.Alerts.Contains(alert))
        {
            AlertService.Remove(alert.Id);

            await InvokeAsync(StateHasChanged);
        }
    }

    private void Close(Guid id)
    {
        AlertService.Remove(id);
    }

    private static string GetAlertClass(AlertType type)
    {
        return type switch
        {
            AlertType.Success => "alert-success",
            AlertType.Warning => "alert-warning",
            AlertType.Info => "alert-info",
            AlertType.Error => "alert-error",
            _ => "alert-info"
        };
    }

    private static string GetIcon(AlertType type)
    {
        return type switch
        {
            AlertType.Success => "bi bi-check-circle-fill",
            AlertType.Warning => "bi bi-exclamation-triangle-fill",
            AlertType.Info => "bi bi-info-circle-fill",
            AlertType.Error => "bi bi-x-circle-fill",
            _ => "bi bi-info-circle-fill"
        };
    }

    public void Dispose()
    {
        AlertService.OnChange -= OnAlertChanged;
    }
}