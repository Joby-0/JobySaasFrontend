@using BlazorBootstrap
@using JobySaasFrontend.Models.DTO
@using JobySaasFrontend.Services
@inject OrganizationStateService OrganizationState
@inject NavigationManager NavigationManager
@inject IOrganizationApiClient OrganizationApi

<div class="sidebar-navigation @(IsCollapsed ? "is-collapsed" : "") d-flex flex-column flex-grow-1">
    <div class="sidebar-top d-flex align-items-center justify-content-between mb-2">
        <Dropdown Class="mb-4 p-0 w-100 ">

            <DropdownToggleButton class="organization-selector d-flex justify-content-between p-2">

                
                <div class="organization-info me-2 d-flex">
                    <div class="me-3 organization-icon">
                        <Icon Name="IconName.People" />
                    </div>
                    <span class="organization-name">
                        @(OrganizationState.CurrentOrganization?.Name ?? "Select organization")
                    </span>
                </div>

                <Icon Class="organization-arrow" Name="IconName.ChevronDown" />

            </DropdownToggleButton>

            <DropdownMenu class="organization-dropdown w-100">

                @foreach (var organization in OrganizationState.Organizations)
                {
                    <DropdownItem @onclick="() => SelectOrganization(organization)">

                        <div class="d-flex align-items-center gap-2 w-100">

                        

                            <span>@organization.Name</span>

                            @if (OrganizationState.CurrentOrganization?.Id == organization.Id)
                            {
                                <i class="bi bi-check ms-auto"></i>
                            }

                        </div>

                    </DropdownItem>
                }

            </DropdownMenu>

        </Dropdown>
    </div>



    <nav class="sidebar-nav d-flex flex-column flex-grow-1" aria-label="Main navigation">

        <!-- GENERAL -->
        <div class="">

            <div class="text-muted small px-2 mb-2">
                GENERAL
            </div>

            <NavLink href="@GetOrgUrl("")" Match="NavLinkMatch.All"
                     class="sidebar-link d-flex align-items-center py-2 px-2 rounded text-dark text-decoration-none">

                <Icon Name="IconName.HouseFill" class="me-3" />

                <span>Home</span>

            </NavLink>

            <NavLink href="@GetOrgUrl("social-accounts")"
                     class="sidebar-link d-flex align-items-center py-2 px-2 rounded text-dark text-decoration-none">

                <Icon Name="IconName.Person" class="me-3" />

                <span>Social accounts</span>

            </NavLink>

            <NavLink href="@GetOrgUrl("dashboard")"
                     class="sidebar-link d-flex align-items-center py-2 px-2 rounded text-dark text-decoration-none">

                <Icon Name="IconName.GridFill" class="me-3" />

                <span>Dashboard</span>

            </NavLink>

            <NavLink href="@GetOrgUrl("organization")"
                     class="sidebar-link d-flex align-items-center py-2 px-2 rounded text-dark text-decoration-none">

                <Icon Name="IconName.People" class="me-3" />

                <span>Organization</span>

            </NavLink>

        </div>

        <div class="border-bottom my-4"></div>
        <!-- TOOLS -->
        <div class="">

            <div class="text-muted small px-2 mb-2">
                TOOLS
            </div>

            <NavLink href="@GetOrgUrl("videos")" class="sidebar-link d-flex align-items-center py-2 px-2 rounded text-dark text-decoration-none">

                <Icon Name="IconName.CameraVideo" class="me-3" />

                <span>Videos</span>

            </NavLink>

        </div>

        <div class="border-bottom my-4"></div>

        <!-- SUPPORT -->
        <div>

            <div class="text-muted small px-2 mb-2">
                SUPPORT
            </div>

            <NavLink href="@GetOrgUrl("help")" class="sidebar-link d-flex align-items-center py-2 px-2 rounded text-dark text-decoration-none">

                <Icon Name="IconName.QuestionCircle" class="me-3" />

                <span>Help</span>

            </NavLink>

        </div>

    </nav>
</div>

@code {
    [Parameter]
    public bool IsCollapsed { get; set; }

    [Parameter]
    public EventCallback<bool> IsCollapsedChanged { get; set; }

    private Task ToggleSidebar() => IsCollapsedChanged.InvokeAsync(!IsCollapsed);

    private List<OrganizationDto> Organizations { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        await OrganizationState.LoadAsync();
    }
    private void SelectOrganization(OrganizationDto organization)
    {
        OrganizationState.SetCurrentOrganization(organization);

        NavigationManager.NavigateTo($"/{organization.Id}/");
    }

    private string GetOrgUrl(string page)
    {
        var organization = OrganizationState.CurrentOrganization;

        if (organization == null)
            return "/";

        return $"/org/{organization.Id}/{page}";
    }
}
