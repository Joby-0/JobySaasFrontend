@page "/onboarding/organization"
@using JobySaasFrontend.Services;
@* @rendermode InteractiveServer *@
@inject OnboardingStateService State
@inject NavigationManager NavigationManager

<div class="d-flex justify-content-center">
    <div class="w-100" style="max-width: 480px;">
        <div class="text-center mb-4">
            <h4 class="fw-bold" style="color: var(--color-primary);">Create your organization</h4>
            <p class="text-muted">This is the workspace your team and content will live in.</p>
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold">Organization name</label>
            <input class="form-control form-control-lg" @bind="State.OrgName" @bind:event="oninput" placeholder="e.g. Acme Studios" />
        </div>

        <div class="d-grid mt-4">
            <button class="btn btn-secondary btn-lg" disabled="@string.IsNullOrWhiteSpace(State.OrgName)" @onclick="Next">
                Continue
            </button>
        </div>
    </div>
</div>

@code {
    private void Next() => NavigationManager.NavigateTo("/onboarding/plan");
}