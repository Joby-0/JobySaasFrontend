@page "/org/{OrganizationId:guid}/social-accounts"
@rendermode InteractiveServer
@using BlazorBootstrap
@using JobySaasFrontend.Services;
@using JobySaasFrontend.Models.DTO;
@using JobySaasFrontend.Components.Components
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject IOrganizationApiClient OrganizationApi
@inject ISocialAccountApiClient SocialAccountApi
@inject IYoutubeApiClient YoutubeApi
@inject NavigationManager NavigationManager

<div class="container">
    <div class="options-bar d-flex justify-content-between">
        <div class="search-div d-flex">

            <div class="search-bar me-2">
                <input class="form-control" type="search" placeholder="Search" @bind="SearchTerm"
                       @bind:event="oninput" />
            </div>

            <div class="mb-3">

                <button class="btn filter-btn border" type="button" @onclick="ToggleFilters">

                    <Icon Name="IconName.Filter" class="me-2" />

                    Filter

                </button>


            </div>

        </div>

        <div>
            <button class="btn btn-outline-primary">Manage accounts</button>
            <button class="btn btn-third" @onclick="OpenAddModal">
                <Icon Name="IconName.Plus" /> Add account
            </button>
        </div>
    </div>

    @if (ShowFilters)
    {
        <div class="filter-bar border rounded mt-2 p-4">

            <div class="row g-3">

                <div class="col-md-4">

                    <label class="form-label">
                        Platform
                    </label>

                    <select class="form-select">
                        <option>All platforms</option>
                        <option>YouTube</option>
                        <option>Instagram</option>
                        <option>TikTok</option>
                        <option>Facebook</option>
                    </select>

                </div>

                <div class="col-md-4">

                    <label class="form-label">
                        Status
                    </label>

                    <select class="form-select">
                        <option>All statuses</option>
                        <option>Connected</option>
                        <option>Expired</option>
                        <option>Error</option>
                    </select>

                </div>


            </div>

        </div>
    }

            

    <div class="list">
        @if (isLoading)
        {
            <div class="text-center py-4"><span class="spinner-border spinner-border-sm"></span></div>
        }
        else if (accounts.Count == 0)
        {
            <p class="text-muted text-center py-4">No social accounts connected yet.</p>
        }
        else
        {
            <div class="mt-5">

                <div class="social-accounts-list">

                    <!-- Header -->
                    <div class="d-flex align-items-center px-3 py-2 text-muted small fw-semibold">

                        <div class="account-status-column"></div>

                        <div class="account-main-column">
                            ACCOUNT
                        </div>

                        <div class="account-stat-column">
                            FOLLOWERS
                        </div>

                        <div class="account-sync-column">
                            LAST SYNC
                        </div>

                        <div class="account-platform-column">
                            PLATFORM
                        </div>

                        <div class="account-action-column"></div>

                    </div>


                    <!-- Accounts -->
                    @foreach (var account in accounts)
                    {
                        <div class="d-flex align-items-center p-3  account-row account-row rounded-2">

                            <!-- Status -->
                            <div class="account-status-column">

                                <Tooltip Color="TooltipColor.Secondary" Title="@GetStatusText(account.Status)">

                                    <span class="status-dot d-inline-block rounded-circle @GetStatusClass(account.Status)" />

                                </Tooltip>

                            </div>


                            <!-- Account -->
                            <div class="account-main-column">

                                <div class="d-flex align-items-center gap-3">

                                    <img src="@account.ProfileImageUrl" alt="@account.AccountName"
                                         class="profile-pic rounded-circle" />

                                    <div class="min-width-0">

                                        <div class="fw-semibold text-dark text-truncate">
                                            @account.AccountName
                                        </div>

                                        <div class="text-muted small text-truncate">
                                            @account.CostumUrl
                                        </div>

                                    </div>

                                </div>

                            </div>


                            <!-- Followers -->
                            <div class="account-stat-column">

                                <span class="fw-semibold">
                                    @account.Followers
                                </span>

                            </div>


                            <!-- Last sync -->
                            <div class="account-sync-column">

                                <div class="d-flex flex-column">

                                    <span class="fw-semibold small">
                                        @account.LastSync.ToShortTimeString()
                                    </span>

                                    <span class="text-muted small">
                                        Synced
                                    </span>

                                </div>

                            </div>


                            <!-- Platform -->
                            <div class="account-platform-column">

                                <span class="badge platform-badge">
                                    @account.Platform.ToString()
                                </span>

                            </div>


                            <!-- Actions -->
                            <div class="account-action-column">

                                <Dropdown>

                                    <DropdownToggleButton Color="ButtonColor.None" class="action-button">

                                        <i class="bi bi-three-dots"></i>

                                    </DropdownToggleButton>

                                    <DropdownMenu Alignment="DropdownMenuAlignment.End">

                                        <DropdownItem>
                                            <i class="bi bi-eye me-2"></i>
                                            View account
                                        </DropdownItem>

                                        <DropdownItem>
                                            <i class="bi bi-arrow-repeat me-2"></i>
                                            Sync now
                                        </DropdownItem>

                                        <DropdownItem>
                                            <i class="bi bi-pencil me-2"></i>
                                            Edit
                                        </DropdownItem>

                                        <DropdownItem>
                                            <i class="bi bi-x-circle me-2"></i>
                                            Disconnect
                                        </DropdownItem>

                                    </DropdownMenu>

                                </Dropdown>

                            </div>

                        </div>
                    }

                </div>
            </div>
        }
    </div>
</div>

<Modal @ref="addModal" Title="Add an account">
    <BodyTemplate>
        <div class="d-grid gap-2">
            <button class="btn btn-outline-black d-flex align-items-center gap-2" @onclick="ConnectYoutube">
                <PlatformIcon Platform="YouTube" /> YouTube
            </button>
            <button class="btn btn-outline-black d-flex align-items-center gap-2" disabled>
                <PlatformIcon Platform="Instagram" /> Instagram <span class="badge bg-secondary ms-auto">Coming
                soon</span>
            </button>
            <button class="btn btn-outline-black d-flex align-items-center gap-2" disabled>
                <PlatformIcon Platform="TikTok" /> TikTok <span class="badge bg-secondary ms-auto">Coming soon</span>
            </button>
        </div>
    </BodyTemplate>
</Modal>

@code {
    private Modal addModal = default!;
    private List<SocialAccountDto> accounts = [];
    private bool isLoading = true;

    [Parameter]
    public Guid OrganizationId { get; set; }

    private string SearchTerm = "";
    private bool ShowFilters = false;

    private void Search(ChangeEventArgs e)
    {
        // Search logic later
    }

    private void ToggleFilters()
    {
        ShowFilters = !ShowFilters;
    }

    private void ClearFilters()
    {
        // Clear filters later
    }

    protected override async Task OnInitializedAsync()
    {
        var result = await SocialAccountApi.GetConnectedAccountsAsync(OrganizationId);

        if (result.Success)
            accounts = result.Data;

        isLoading = false;
    }

    private async Task OpenAddModal() => await addModal.ShowAsync();

    private async Task ConnectYoutube()
    {
        var authUrl = await YoutubeApi.GetConnectUrlAsync(OrganizationId);

        NavigationManager.NavigateTo(authUrl, forceLoad: true);
    }

    private string GetStatusClass(SocialAccountStatus status)
    {
        return status switch
        {
            SocialAccountStatus.Connected => "status-connected",
            SocialAccountStatus.Expired => "status-expired",
            SocialAccountStatus.Error => "status-error",
            SocialAccountStatus.Disconnected => "status-disconnected",
            _ => "status-unknown"
        };
    }

    private string GetStatusText(SocialAccountStatus status)
    {
        return status switch
        {
            SocialAccountStatus.Connected => "Connected",
            SocialAccountStatus.Expired => "Connection expired",
            SocialAccountStatus.Error => "Connection error",
            SocialAccountStatus.Disconnected => "Disconnected",
            _ => "Unknown status"
        };
    }
}