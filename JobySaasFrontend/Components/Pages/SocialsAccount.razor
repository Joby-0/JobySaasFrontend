@page "/org/{OrganizationId:guid}/social-accounts"
@rendermode InteractiveServer
@using BlazorBootstrap
@using JobySaasFrontend.Services;
@using JobySaasFrontend.Models.DTO;
@using JobySaasFrontend.Components.Components
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject IOrganizationApiClient OrganizationApi
@inject ISocialAccountApiClient SocialAccountApi
@inject IYoutubeApiClient YoutubeApi
@inject NavigationManager NavigationManager

<div class="container">
    <div class="options-bar d-flex justify-content-between">
        <div class="search-div">

            <div class="search-bar">
                <input class="form-control" type="search" placeholder="Search social accounts..." @bind="SearchTerm"
                       @bind:event="oninput" />
            </div>

            <button class="btn filter-btn" type="button" @onclick="ToggleFilters">
                <Icon Name="IconName.Filter" />
            </button>

        </div>

        @if (ShowFilters)
        {
            <div class="filter-bar">

                

            </div>
        }
        <div>
            <button class="btn btn-outline-primary">Manage accounts</button>
            <button class="btn btn-third" @onclick="OpenAddModal">
                <Icon Name="IconName.Plus" /> Add account
            </button>
        </div>
    </div>

    <div class="list">
        @if (isLoading)
        {
            <div class="text-center py-4"><span class="spinner-border spinner-border-sm"></span></div>
        }
        else if (accounts.Count == 0)
        {
            <p class="text-muted text-center py-4">No social accounts connected yet.</p>
        }
        else
        {
            // vill man ha en header på listan med vad varje fät är typ eller några kanske typ subs last sync och platform kanske 
            @foreach (var account in accounts)
            {
                <div class="d-flex align-items-center justify-content-between border-bottom py-2">
                    <div>
                        <Tooltip Color="TooltipColor.Secondary" Title="status">
                            <div class="dot">.</div>
                        </Tooltip>
                    </div>
                    <div class="d-flex align-items-center gap-3">
                        <img src="@account.ProfileImageUrl" alt="@account.AccountName" class="profile-pic rounded-circle" />
                        <div>
                            <div class="fw-semibold">@account.AccountName</div>
                            <div class="text-muted small">@account.AccountName</div>
                        </div>
                    </div>
                    <div>
                        <span>Followers/subs</span>
                    </div>
                    <div class="d-flex">
                        <div class="d-block">
                            <span class="fw-semibold">Last sync</span>
                            <span class="text-muted small">last sync</span>
                        </div>

                    </div>
                    <div>
                        <button class="btn">Show more</button>
                        @* eller vill man ha en liten meny som dycker på på tre ... *@
                    </div>
                </div>
            }
        }
    </div>
</div>

<Modal @ref="addModal" Title="Add an account">
    <BodyTemplate>
        <div class="d-grid gap-2">
            <button class="btn btn-outline-black d-flex align-items-center gap-2" @onclick="ConnectYoutube">
                <PlatformIcon Platform="YouTube" /> YouTube
            </button>
            <button class="btn btn-outline-black d-flex align-items-center gap-2" disabled>
                <PlatformIcon Platform="Instagram" /> Instagram <span class="badge bg-secondary ms-auto">Coming
                soon</span>
            </button>
            <button class="btn btn-outline-black d-flex align-items-center gap-2" disabled>
                <PlatformIcon Platform="TikTok" /> TikTok <span class="badge bg-secondary ms-auto">Coming soon</span>
            </button>
        </div>
    </BodyTemplate>
</Modal>

@code {
    private Modal addModal = default!;
    private List<SocialAccountDto> accounts = [];
    private bool isLoading = true;

    [Parameter]
    public Guid OrganizationId { get; set; }

    private string SearchTerm = "";
    private bool ShowFilters = false;

    private void Search(ChangeEventArgs e)
    {
        // Search logic later
    }

    private void ToggleFilters()
    {
        ShowFilters = !ShowFilters;
    }

    private void ClearFilters()
    {
        // Clear filters later
    }

    protected override async Task OnInitializedAsync()
    {
        var result = await SocialAccountApi.GetConnectedAccountsAsync(OrganizationId);

        if (result.Success)
            accounts = result.Data;

        isLoading = false;
    }

    private async Task OpenAddModal() => await addModal.ShowAsync();

    private async Task ConnectYoutube()
    {
        var authUrl = await YoutubeApi.GetConnectUrlAsync(OrganizationId);

        NavigationManager.NavigateTo(authUrl, forceLoad: true);
    }
}