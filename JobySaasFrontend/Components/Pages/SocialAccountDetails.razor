@page "/{organizationId:guid}/accountdetails/{accountId:guid}"
@using BlazorBootstrap
@using JobySaasFrontend.Components.Components
@using JobySaasFrontend.Services
@using JobySaasFrontend.Models.DTO
@inject ISocialAccountApiClient SocialAccountApi

<div class="container">
    @if (isLoading)
    {

    }
    else
    {
        <div class="banner" style="background-image: url('@details.AccountBanner');"></div>
        <div class="d-flex pt-3">
            <div class="img"><img src="@details.ProfileImageUrl" alt=""></div>
            <div class="ps-4">
                <h3 class="fw-bold">@details.AccountName</h3>
                <span class="small muted">@details.Handle</span>
                <div class="count-div d-flex gap-4">
                    <div class="d-flex align-items-center gap-2">
                        <Icon Name="IconName.Person" />
                        <strong>@details.Followers</strong>
                    </div>

                    <div class="d-flex align-items-center gap-2">
                        <Icon Name="IconName.Eye" />
                        <strong>@details.Views</strong>
                    </div>

                    <div class="d-flex align-items-center gap-2">
                        <Icon Name="IconName.Film" />
                        <strong>@details.VideoCount</strong>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <Icon Name="IconName.ChatLeftText" />
                        <strong>@details.CommentCount</strong>
                    </div>
                </div>
            </div>
        </div>
        <div class="account-tabs mt-5">
            <ul class="nav nav-tabs">
                <li class="nav-item">
                    <button class="nav-link @(activeTab == AccountTab.Overview ? "active" : "")"
                            @onclick="() => activeTab = AccountTab.Overview">
                        Overview
                    </button>
                </li>

                <li class="nav-item">
                    <button class="nav-link @(activeTab == AccountTab.Videos ? "active" : "")"
                            @onclick="() => activeTab = AccountTab.Videos">
                        Videos
                    </button>
                </li>

                <li class="nav-item">
                    <button class="nav-link @(activeTab == AccountTab.Shorts ? "active" : "")"
                            @onclick="() => activeTab = AccountTab.Shorts">
                        Shorts
                    </button>
                </li>

                <li class="nav-item">
                    <button class="nav-link @(activeTab == AccountTab.AccountInfo ? "active" : "")"
                            @onclick="() => activeTab = AccountTab.AccountInfo">
                        Account info
                    </button>
                </li>
            </ul>
        </div>

        //overview tab
        @if (activeTab == AccountTab.Overview)
        {
            <AccountOverview analytics="analytics" isAnalyticsLoading="isAnalyticsLoading"
                             IsRecentVideosLoading="IsRecentVideosLoading" />
        }
        @if (activeTab == AccountTab.Videos)
        {
            <div class="py-4">
                <h4>Videos</h4>

                @* Your videos component/content *@
            </div>
        }

        @if (activeTab == AccountTab.Shorts)
        {
            <div class="py-4">
                <h4>Shorts</h4>
                @* Your shorts component/content *@
            </div>
        }

        @if (activeTab == AccountTab.AccountInfo)
        {
            <div class="py-4">
                <h4>Account information</h4>

                <div class="account-info">
                    @* Account information *@
                </div>
            </div>
        }
        //vidoes
        //short
        //idk
    }
</div>

@code {
    [Parameter]
    public Guid organizationId { get; set; }

    [Parameter]
    public Guid accountId { get; set; }

    private SocialAccountDetailsDto? details;
    private List<DailyMetricDto>? analytics;
    @* private List<VideoDto>? videos;
    private List<ShortDto>? shorts;
    private AccountInfoDto? accountInfo;  *@

    private bool isLoading = true;
    private bool isAnalyticsLoading = true;
    private bool IsRecentVideosLoading = true;
    private bool isVideosLoading = true;
    private bool isShortsLoading = true;
    private bool isAccountInfoLoading = true;

    private AccountTab activeTab = AccountTab.Overview;

    private enum AccountTab
    {
        Overview,
        Videos,
        Shorts,
        AccountInfo
    }

    protected override async Task OnInitializedAsync()
    {
        var result = await SocialAccountApi.GetAccountDetailsAsync(organizationId, accountId);
        var analyticsTask = LoadAnalytics();

        if (result.Success)
            details = result.Data;
        else
        {
        }
        await Task.WhenAll(analyticsTask);
        isLoading = false;

    }

    private async Task LoadAnalytics()
    {
        var endDate = DateOnly.FromDateTime(DateTime.UtcNow);
        var startDate = endDate.AddDays(-30);

        var result = await SocialAccountApi.GetAccountPerformanceAsync(organizationId, accountId, startDate, endDate,
CancellationToken.None);

        if (result.Success)
            analytics = result.Data;
        else
        {
        }
        isAnalyticsLoading = false;
    }
}