@page "/{organizationId:guid}/accountdetails/{accountId:guid}"
@using BlazorBootstrap
@using JobySaasFrontend.Components.Components
@using JobySaasFrontend.Services
@using JobySaasFrontend.Models.DTO
@inject ISocialAccountApiClient SocialAccountApi
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<div class="container">
    @if (isLoading)
    {

    }
    else
    {
        <div class="banner" style="background-image: url('@details.AccountBanner');"></div>
        <div class="d-flex pt-3">
            <div class="img"><img src="@details.ProfileImageUrl" alt=""></div>
            <div class="ps-4">
                <h3 class="fw-bold mb-0">@details.AccountName</h3>
                <span class="small muted">@details.Handle</span>
                <div class="count-div d-flex gap-4 mt-2">
                    <div class="d-flex align-items-center gap-2">
                        <Icon Name="IconName.Person" />
                        <strong>@details.Followers</strong>
                    </div>

                    <div class="d-flex align-items-center gap-2">
                        <Icon Name="IconName.Eye" />
                        <strong>@details.Views</strong>
                    </div>

                    <div class="d-flex align-items-center gap-2">
                        <Icon Name="IconName.Film" />
                        <strong>@details.VideoCount</strong>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <Icon Name="IconName.ChatLeftText" />
                        <strong>@details.CommentCount</strong>
                    </div>
                </div>
            </div>
        </div>
        <div class="account-tabs mt-5">
            <ul class="nav nav-tabs">
                <li class="nav-item">
                    <button class="nav-link color-primary @(activeTab == AccountTab.Overview ? "active" : "")"
                            @onclick="() => activeTab = AccountTab.Overview">
                        Overview
                    </button>
                </li>

                <li class="nav-item">
                    <button class="nav-link color-primary @(activeTab == AccountTab.Videos ? "active" : "")"
                            @onclick="() => activeTab = AccountTab.Videos">
                        Videos
                    </button>
                </li>

                <li class="nav-item">
                    <button class="nav-link color-primary @(activeTab == AccountTab.Shorts ? "active" : "")"
                            @onclick="() => activeTab = AccountTab.Shorts">
                        Shorts
                    </button>
                </li>

                <li class="nav-item">
                    <button class="nav-link color-primary @(activeTab == AccountTab.AccountInfo ? "active" : "")"
                            @onclick="() => activeTab = AccountTab.AccountInfo">
                        Account info
                    </button>
                </li>
            </ul>
        </div>

        //overview tab
        @if (activeTab == AccountTab.Overview)
        {
            <AccountOverview analytics="analytics" isAnalyticsLoading="isAnalyticsLoading"
                             IsRecentVideosLoading="IsRecentVideosLoading" IsChartLoading="isChartLoading"
                             OnRangeChanged="HandleRangeChanged" />
        }
        @if (activeTab == AccountTab.Videos)
        {
            <div class="py-4">
                <h4>Videos</h4>

                @* Your videos component/content *@
            </div>
        }

        @if (activeTab == AccountTab.Shorts)
        {
            <div class="py-4">
                <h4>Shorts</h4>
                @* Your shorts component/content *@
            </div>
        }

        @if (activeTab == AccountTab.AccountInfo)
        {
            <div class="py-4">
                <h4>Account information</h4>

                <div class="account-info">
                    @* Account information *@
                </div>
            </div>
        }
        //vidoes
        //short
        //idk
    }
</div>
@code {
    [Parameter]
    public Guid organizationId { get; set; }

    [Parameter]
    public Guid accountId { get; set; }

    private SocialAccountDetailsDto? details;
    private List<DailyMetricDto>? analytics;
    @* private List<VideoDto>? videos;
    private List<ShortDto>? shorts;
    private AccountInfoDto? accountInfo;  *@

    private bool isLoading = true;
    private bool isAnalyticsLoading = true;
    private bool isChartLoading;
    private bool IsRecentVideosLoading = true;
    private bool isVideosLoading = true;
    private bool isShortsLoading = true;
    private bool isAccountInfoLoading = true;

    private CancellationTokenSource? _analyticsCts;

    private AccountTab activeTab = AccountTab.Overview;

    private enum AccountTab
    {
        Overview,
        Videos,
        Shorts,
        AccountInfo
    }

    protected override async Task OnInitializedAsync()
    {
        var result = await SocialAccountApi.GetAccountDetailsAsync(organizationId, accountId);

        if (result.Success)
            details = result.Data;
        else
        {
        }

        // Unblock the page as soon as the header/banner/tabs data is in -
        // don't wait on analytics, recent videos, etc.
        isLoading = false;

        // Fire-and-forget: this updates its own loading flags and calls
        // StateHasChanged() when it resolves, so the Overview tab's chart
        // section pops in on its own instead of blocking first paint.
        var endDate = DateOnly.FromDateTime(DateTime.UtcNow);
        var startDate = endDate.AddDays(-30);
        _ = LoadAnalyticsAsync(startDate, endDate);
    }

    /// Called by AccountOverview whenever the user picks a new preset or
    /// custom time range.
    private async Task HandleRangeChanged((DateOnly Start, DateOnly End) range)
    {
        await LoadAnalyticsAsync(range.Start, range.End, isInitialLoad: false);
    }

    private async Task LoadAnalyticsAsync(DateOnly startDate, DateOnly endDate, bool isInitialLoad = true)
    {
        // Cancel any in-flight request for a previous range so a slow older
        // response can't overwrite a newer one if the user switches fast.
        _analyticsCts?.Cancel();
        _analyticsCts = new CancellationTokenSource();
        var token = _analyticsCts.Token;

        if (isInitialLoad)
            isAnalyticsLoading = true;
        else
            isChartLoading = true;

        await InvokeAsync(StateHasChanged);

        try
        {
            var result = await SocialAccountApi.GetAccountPerformanceAsync(
                organizationId, accountId, startDate, endDate, token);

            if (token.IsCancellationRequested)
                return;

            if (result.Success)
                analytics = result.Data;
            else
            {
            }
        }
        catch (OperationCanceledException)
        {
            // Superseded by a newer range selection - ignore.
            return;
        }
        catch (Exception)
        {
            // TODO: surface an error state to the user (e.g. a toast) -
            // swallowing here at minimum keeps a background failure from
            // crashing the circuit.
        }
        finally
        {
            if (!token.IsCancellationRequested)
            {
                isAnalyticsLoading = false;
                isChartLoading = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }
}