@page "/Account/Register"
@rendermode InteractiveServer
@layout AuthLayout
@using BlazorBootstrap

<PageTitle>Register</PageTitle>

<div class="row min-vh-100 align-items-center justify-content-center">
    <div id="signupbox" class="col-lg-5 rounded-3 border-1 p-5">
        <section>
            

            @if (showConfirmation)
            {
                <div class="text-center p-3">
                    <div class="display-4 color-primary mb-3" aria-hidden="true"><Icon Name="IconName.Envelope" Size="IconSize.x1"/></div>
                    <h2>Check your email</h2>
                    <p class="mb-4">We've sent a confirmation link to <strong>@registeredEmail</strong>. Please click the
                        link in the email to verify your email address.</p>
                        <p class="mb-2">Already confirmed your email?</p>
                        <a class="btn btn-primary" href="/Account/Login">Sign in</a>
                    </div>
                }
            else
                {
                    <h1 class="pb-3 fw-bold ">Create your Joby-account now</h1>
                    <EditForm class="signup-form" Model="registerModel" OnValidSubmit="HandleSubmit" FormName="register">
                        <DataAnnotationsValidator />

                        @if (errorMessage is not null)
                        {
                            <div class="alert alert-danger" role="alert">@errorMessage</div>
                        }

                        <div class="row g-3 register-form">
                            <div class="col-12 form-floating">
                                <InputText id="register-full-name" class="form-control" placeholder="Full name"
                                           autocomplete="name" @bind-Value="registerModel.FullName" />
                                <label for="register-full-name">Full name</label>
                                <ValidationMessage For="@(() => registerModel.FullName)"
                                                   class="invalid-feedback d-block ps-1" />
                            </div>
                            <div class="col-12 form-floating">
                                <InputText id="register-email" class="form-control" type="email" placeholder="Email"
                                           autocomplete="email" @bind-Value="registerModel.Email" />
                                <label for="register-email">Email</label>
                                <ValidationMessage For="@(() => registerModel.Email)" class="invalid-feedback d-block ps-1" />
                            </div>
                            <div class="col-12 form-floating">
                                <InputText id="register-password" class="form-control" type="password" placeholder="Password"
                                           autocomplete="new-password" @bind-Value="registerModel.Password" />
                                <label for="register-password">Password</label>
                                <ValidationMessage For="@(() => registerModel.Password)"
                                                   class="invalid-feedback d-block ps-1" />
                            </div>
                            <div class="col-12 form-floating">
                                <InputText id="register-confirm-password" class="form-control" type="password"
                                           placeholder="Confirm password" autocomplete="new-password"
                                           @bind-Value="registerModel.ConfirmPassword" />
                                <label for="register-confirm-password">Confirm password</label>
                                <ValidationMessage For="@(() => registerModel.ConfirmPassword)"
                                                   class="invalid-feedback d-block ps-1" />
                            </div>
                        </div>

                        <div class="d-grid mt-4">
                            <button type="submit" class="btn btn-primary" disabled="@isSubmitting">
                                <button type="submit" class="btn btn-primary" disabled="@isSubmitting">
                                    @if (isSubmitting)
                                    {
                                        <Spinner Color="SpinnerColor.Secondary" />
                                    }
                                    else
                                    {
                                        <span>Sign up</span>
                                    }
                                </button>
                            </button>
                        </div>

                        <div class="signup-divider" aria-hidden="true">
                            <span>or sign up with</span>
                        </div>
                    </EditForm>
                    <div class="d-grid">
                        <button type="button" class="btn btn-outline-secondary" disabled="@isSubmitting">
                            Sign up with Google
                        </button>
                    </div>
                    <p class="text-center mt-4">Already have an account? <a href="/Account/Login">Sign in</a></p>
                }
            </section>
        </div>
    </div>
