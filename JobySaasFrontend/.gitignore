## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
##
## Original source: https://github.com/github/gitignore/blob/main/VisualStudio.gitignore

# User-specific files
*.rsuser
*.suo
*.user
*.user-rgt
*.usertasks
*.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Mono auto-generated files
mono_crash.*

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Re]leases/
x64/
x86/
[Aa]rm/
[Aa]rm64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio 2015/2017/2019/2022 cache directory
.vs/

# Visual Studio Code directory
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/code-workspace

# VS Office Developer Tools cache
-Visual Studio Image Library

# Rider
.idea/
*.sln.iml

# Backup and its folder from temporaries that are created by website templates
_backup/
*~

# MSTest test Results
[Tt]est[Rr]esults/

# Modern C++ project build output folder
out/

# OpenCover output
*opencover*.xml

# Exclude tracking of performance reports
*.psess
*.vsp
*.vspx
*.sap

# JetBrains Profiler runs
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# NUnit
/*.VisualState.xml

# Selenium WebDriver Chromedriver
chromedriver.exe

# Visual Studio code coverage results
*.coverage
*.coveragexml

# MyGet package files
*.nupkg

# NuGet Packages
*.nuget.props
*.nuget.targets

# Microsoft Fakes
FakesAssemblies/

# GhostDoc Local License database
*GhostDoc.UserPhotos.xml

# Sensei settings
.senseisettings

# AppInsights config file - used for local debugging
ApplicationInsights.config

# Logger output
*.log

# SQLite database files
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Windows temporary files
Thumbs.db
ehthumbs.db
Desktop.ini

# Mac temporary files
.DS_Store
